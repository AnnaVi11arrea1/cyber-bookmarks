[Unit]
Description=NEURAL//LINKS security feed (LAN only, read-only)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/secfeed.env
ExecStart=/usr/bin/python3 /opt/secfeed/secfeed.py
User=secfeed
Group=secfeed
# adm: fail2ban/auth logs, systemd-journal: sshd journal
SupplementaryGroups=adm systemd-journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
