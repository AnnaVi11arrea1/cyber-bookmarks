{
  "manifest_version": 3,
  "name": "NEURAL//LINKS — Cyberpunk Bookmarks",
  "short_name": "NEURAL//LINKS",
  "version": "1.0.0",
  "description": "A neon side-panel bookmark manager: drag to reorder, group into folders, nest subfolders.",
  "permissions": ["bookmarks", "sidePanel", "tabs", "favicon", "storage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://www.linkedin.com/*", "https://dev.to/*", "https://api.stripe.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": {
    "default_title": "NEURAL//LINKS",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open NEURAL//LINKS"
    }
  }
}
